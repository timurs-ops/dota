// ============================================
// МЕТА: локальный JSON + попытка обновления через прокси
// ============================================

let liveStats = {};
let metaLoaded = false;

function pct(v) { return v ? (v * 100).toFixed(1) + '%' : '—'; }

function getHeroStats(hero) {
    return liveStats[(hero.name || '').toLowerCase()] || null;
}

// Загрузка локального JSON (всегда работает)
async function loadLocalMeta() {
    try {
        const res = await fetch('data/meta.json');
        if (!res.ok) return false;
        const data = await res.json();
        liveStats = {};
        data.forEach(h => {
            liveStats[(h.localized_name || '').toLowerCase()] = h;
        });
        metaLoaded = true;
        return true;
    } catch (e) {
        console.warn('Local meta load error:', e);
        return false;
    }
}

// Попытка обновить через прокси (если локальные данные уже есть)
async function tryRefreshMeta(showStatus) {
    const status = document.getElementById('metaStatus');
    if (showStatus && status) status.textContent = 'Мета: проверка обновлений...';

    try {
        const proxyUrl = 'https://api.allorigins.win/raw?url=' +
            encodeURIComponent('https://api.opendota.com/api/heroStats');
        const res = await fetch(proxyUrl, {cache: 'no-cache'});
        if (!res.ok) throw new Error('HTTP ' + res.status);
        const data = await res.json();

        liveStats = {};
        data.forEach(h => {
            liveStats[(h.localized_name || '').toLowerCase()] = h;
        });
        metaLoaded = true;
        if (status) status.textContent = `Мета: обновлено ${data.length} героев ✅`;
        return true;
    } catch (e) {
        console.warn('Refresh failed:', e);
        if (status) status.textContent = `Мета: локальные данные (${Object.keys(liveStats).length} героев)`;
        return false;
    }
}

async function loadLiveStats(showStatus) {
    const status = document.getElementById('metaStatus');
    if (showStatus && status) status.textContent = 'Мета: загрузка...';

    // Сначала локальные данные (гарантированно работают)
    const localOk = await loadLocalMeta();

    // Потом пробуем обновить
    if (localOk) {
        await tryRefreshMeta(showStatus);
    } else {
        if (status) status.textContent = 'Мета: не удалось загрузить данные';
    }
}

function getMetaAnswer() {
    const list = Object.values(liveStats)
        .filter(h => h.pub_pick && h.pub_pick > 0.02 && h.pub_win)
        .sort((a, b) => b.pub_win - a.pub_win)
        .slice(0, 5);
    if (!list.length) return null;
    const rows = list.map((h, i) =>
        `${i + 1}. <strong>${h.localized_name}</strong> — винрейт ${pct(h.pub_win)}, пикрейт ${pct(h.pub_pick)}`
    ).join('<br>');
    return `📈 <strong>Актуальная мета патча:</strong><br>${rows}`;
}

function getWinrateAnswer(question) {
    const hero = (typeof findHero === 'function') ? findHero(question) : null;
    if (!hero) return null;
    const s = getHeroStats(hero);
    if (!s) return `📊 Нет данных по <strong>${hero.name}</strong>.`;
    return `📊 <strong>${hero.name} (${hero.ru})</strong>:<br>` +
        `• Паблик: винрейт <strong>${pct(s.pub_win)}</strong>, пикрейт ${pct(s.pub_pick)}<br>` +
        `• Просцена: винрейт <strong>${pct(s.pro_win)}</strong>, пикрейт ${pct(s.pro_pick)}`;
}

document.addEventListener('DOMContentLoaded', () => {
    loadLiveStats();
});
